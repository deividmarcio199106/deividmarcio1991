# Copie para .env (nunca versione o .env real).
PORT=8081
NODE_ENV=production

# Diretorio persistente do SQLite. Em Docker/Render/Fly use um volume.
DATA_DIR=/app/data

# IA opcional. O navegador nunca fala com o Ollama: so o backend.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_TEXT_MODEL=qwen3.5:35b
# Preencha apenas com um modelo multimodal realmente instalado.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_MS=120000
OLLAMA_HEALTH_TIMEOUT_MS=5000
